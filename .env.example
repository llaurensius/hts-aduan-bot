# =============================================================================
# HTS Ticket Monitor - Environment Configuration
# =============================================================================

# --- HTS Credentials (REQUIRED) ---
HTS_BASE_URL=https://hts.diskomdigi.jatengprov.go.id
HTS_USERNAME=your_username_here
HTS_PASSWORD=your_password_here

# --- Telegram Bot (REQUIRED) ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# --- Polling & Network ---
POLL_INTERVAL=5
REQUEST_TIMEOUT=10
RETRY_INITIAL_DELAY=15
MAX_RETRY_DELAY=1800

# --- Telegram Notification ---
MAX_TELEGRAM_RETRY=0
INITIAL_SYNC=true

# --- Logging & Database ---
LOG_LEVEL=INFO
LOG_FILE=logs/hts_monitor.log
DB_PATH=data/hts_monitor.db

# --- Backup Configuration ---
BACKUP_ENABLED=true
BACKUP_DIR=data/backups
BACKUP_RETAIN_DAYS=7

# --- Health Check Server ---
HEALTH_PORT=8080
HEALTH_HOST=127.0.0.1

# --- Intervals & Behavior ---
CHANGE_DEBOUNCE_SECONDS=0
CAPTCHA_REMINDER_INTERVAL=1800
SESSION_CHECK_INTERVAL=60

# --- Operator / Helpdesk Profile ---
PETUGAS_NAMA="Nama Petugas"
PETUGAS_ROLE="Helpdesk DC"
